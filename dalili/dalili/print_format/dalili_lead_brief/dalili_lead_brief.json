 "disabled": 0,
 "doc_type": "Dalili Lead List",
 "doctype": "Print Format",
 "font_size": 12,
 "html": "<div class=\"dalili-brief\">\n  <div class=\"head\">\n    <div>\n      <div class=\"brand\">DALILI LEAD BRIEF</div>\n      <div class=\"title\">{{ doc.list_name | e }}</div>\n    </div>\n    <div class=\"meta\">\n      <div>{{ frappe.utils.formatdate(doc.generated_on or frappe.utils.nowdate()) }}</div>\n      <div>{{ doc.total_prospects or 0 }} prospects &middot; {{ doc.verified_count or 0 }} verified</div>\n      <div>Avg score {{ doc.avg_score or 0 }}</div>\n    </div>\n  </div>\n\n  <table class=\"leads\">\n    <thead>\n      <tr>\n        <th style=\"width:26px\">#</th>\n        <th>Company &amp; why now</th>\n        <th style=\"width:150px\">Contact</th>\n        <th style=\"width:52px\">Score</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for row in doc.items %}\n        {% if row.included %}\n        <tr>\n          <td class=\"rank\">{{ row.rank }}</td>\n          <td>\n            <div class=\"company\">{{ row.company_name or row.prospect | e }}</div>\n            {% if row.why_now %}<div class=\"why\">{{ row.why_now | e }}</div>{% endif %}\n          </td>\n          <td>\n            <div>{{ row.contact_name or \"—\" | e }}</div>\n            <div class=\"muted\">{{ row.whatsapp or row.phone or \"\" | e }}</div>\n          </td>\n          <td class=\"score\">{{ row.score | round | int }}</td>\n        </tr>\n        {% endif %}\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <div class=\"foot\">\n    Wrong number? Reply BAD &lt;n&gt; and we replace it free.\n    Verified contacts are checked every 30 days.\n  </div>\n</div>\n\n<style>\n  .dalili-brief { font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, sans-serif; color:#111; }\n  .dalili-brief .head { display:flex; justify-content:space-between; align-items:flex-start;\n    border-bottom:2px solid #1f3b57; padding-bottom:10px; margin-bottom:14px; }\n  .dalili-brief .brand { font-size:10px; letter-spacing:1.6px; color:#1f3b57; font-weight:700; }\n  .dalili-brief .title { font-size:17px; font-weight:600; margin-top:4px; }\n  .dalili-brief .meta { text-align:right; font-size:10px; color:#666; line-height:1.6; }\n  .dalili-brief table.leads { width:100%; border-collapse:collapse; font-size:11px; }\n  .dalili-brief table.leads th { text-align:left; color:#1f3b57; border-bottom:1px solid #cbd5e1;\n    padding:6px 5px; font-size:10px; text-transform:uppercase; letter-spacing:.5px; }\n  .dalili-brief table.leads td { border-bottom:1px solid #eef1f5; padding:8px 5px; vertical-align:top; }\n  .dalili-brief .rank { color:#9aa4b2; }\n  .dalili-brief .company { font-weight:600; }\n  .dalili-brief .why { color:#0b6b3a; font-size:10px; margin-top:2px; }\n  .dalili-brief .muted { color:#6b7280; font-size:10px; }\n  .dalili-brief .score { text-align:right; font-weight:700; }\n  .dalili-brief .foot { margin-top:14px; border-top:1px solid #eef1f5; padding-top:8px;\n    font-size:9px; color:#8a94a6; }\n</style>",
